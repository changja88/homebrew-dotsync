# Copy this file to config/macos-release.env and fill in the quoted values.
# The local file is ignored by Git. Never put passwords, private keys, API
# keys, or app-specific passwords in either file.

# Copy the exact quoted identity reported by:
#   security find-identity -v -p codesigning
export DEVELOPER_ID_APPLICATION=''

# This is a local Keychain profile name that you choose. It is not a password.
export NOTARYTOOL_PROFILE='dotsync-notary'

# Setup-only values used when creating the Keychain profile. The release script
# consumes the two values above; it does not read these two fields directly.
export APPLE_TEAM_ID=''
export APPLE_ACCOUNT_EMAIL=''
